{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autocomplete/catalog/manual.schema.json",
  "title": "AutoComplete approved manual catalog additions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "windows_executables"],
        "properties": {
          "id": { "type": "string", "pattern": "^manual:[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "windows_executables": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": { "type": "string", "minLength": 5, "maxLength": 128 }
          }
        }
      }
    }
  }
}
